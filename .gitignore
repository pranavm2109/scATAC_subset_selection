# Large input data, production outputs and execution state.
/data/
/results/
/logs/
/tmp/
/figures/
.snakemake/
slurm-*.out
*.log

# Generated diagnostic directories; retain top-level analysis source and notes.
/diagnostics/*
!/diagnostics/*.py
!/diagnostics/*.R
!/diagnostics/*.r
!/diagnostics/*.md
!/diagnostics/*.sbatch

# Manuscript drafts, staging and one-time packaging artifacts.
/manuscript_preparation/
/docs/pseudocode_before_*.txt

# Publication code/captions/reports remain visible; generated bulk stays local.
/publication_figures/archive/
/publication_figures/benchmarks/
/publication_figures/logs/
/publication_figures/figures/
/publication_figures/tables/
/publication_figures/figure_tables/
/publication_figures/supplementary_figures/*.pdf
/publication_figures/supplementary_figures/*.svg
/publication_figures/supplementary_figures/*.png
/publication_figures/reports/**/pdf_proofs/
/publication_figures/reports/**/final_figure_proofs/
/publication_figures/reports/**/render_work/
/publication_figures/reports/**/*.tsv
/publication_figures/reports/**/*.csv
/publication_figures/reports/**/*.psv
/publication_figures/reports/**/*.json
/publication_figures/reports/**/*.png
/publication_figures/reports/**/*.pdf
/publication_figures/reports/**/*.svg
/publication_figures/DELETION_MANIFEST.tsv
/publication_figures/LATEST_REORGANIZATION.txt

# Keep only the definitive main figure and its technical description here.
/publication_figures/main_figures/*
!/publication_figures/main_figures/Figure_1_rare_population_representation_and_DA_fidelity.pdf
!/publication_figures/main_figures/Figure_1_rare_population_representation_and_DA_fidelity.svg
!/publication_figures/main_figures/Figure_1_rare_population_representation_and_DA_fidelity.png
!/publication_figures/main_figures/Figure_1_rare_population_representation_and_DA_fidelity.md

# Protect against large scientific binaries accidentally saved elsewhere.
*.h5ad
*.h5
*.hdf5
*.rds
*.RDS
*.RData
*.rda
*.npy
*.npz
*.mtx
*.mtx.gz
*.rds.gz
*.RDS.gz
*.bam
*.bai
*.cram
*.crai
*.pt
*.pth
*.ckpt
*.tar
*.tar.gz
*.tgz

# Python caches, build outputs and local virtual environments.
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Editor/OS files, backups and local assistant state.
.DS_Store
Thumbs.db
.vscode/
.idea/
.codex/
.agents/
*.swp
*.swo
*~
*.bak
*.orig
*.rej

# Local credentials/settings; env/*.yaml remains tracked.
.env
.env.*
!.env.example
!.env.template
.aws/
.ssh/
*.pem
*.key
