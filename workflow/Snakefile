# Step 1: preprocess each atlas to raw-count Seurat object
# ---------------------------------

rule preprocess_atlas:
    input:
        script=preprocess_script
    output:
        rds="data/processed/{atlas}/{atlas}_barebones_seurat.rds"
    log:
        "logs/preprocessing/{atlas}.log"
    benchmark:
        "logs/benchmarking/preprocessing/{atlas}.tsv"
    threads: 1
    resources:
        mem_mb=256000,
        runtime=1440
    shell:
        r"""
        set +u
        eval "$(conda shell.bash hook)"
        conda activate r_env2
        set -u
        export TMPDIR=${{TMPDIR:-/tmp}}
        export MPLCONFIGDIR=${{MPLCONFIGDIR:-/tmp/mpl-$USER-$SLURM_JOB_ID}}
        Rscript {input.script} > {log} 2>&1
        """


# ---------------------------------
# Step 2.1: convert Seurat raw counts to AnnData for PeakVI
# ---------------------------------

rule convert_seurat_to_anndata:
    input:
        rds="data/processed/{atlas}/{atlas}_barebones_seurat.rds"
    output:
        export_dir=directory("results/anndata/{atlas}/sparse_export"),
        h5ad="results/anndata/{atlas}/{atlas}_peakvi_input.h5ad"
    log:
        "logs/anndata/{atlas}.log"
    benchmark:
        "logs/benchmarking/anndata/{atlas}.tsv"
    threads: 1
    resources:
        mem_mb=128000,
        runtime=720
    params:
        chunk_size=5000
    shell:
        r"""
        set +u
        eval "$(conda shell.bash hook)"
        conda activate r_env2
        set -u
        export TMPDIR=${{TMPDIR:-/tmp}}
        export MPLCONFIGDIR=${{MPLCONFIGDIR:-/tmp/mpl-$USER-$SLURM_JOB_ID}}
        Rscript scripts/02_1_export_seurat_counts_for_anndata.R             {input.rds}             {output.export_dir}             {params.chunk_size}             > {log} 2>&1

        set +u
        conda activate scvi
        set -u
        python scripts/02_2_build_peakvi_anndata.py             --input_dir {output.export_dir}             --output_h5ad {output.h5ad}             >> {log} 2>&1
        """


# ---------------------------------
# Step 2.2: train PeakVI and export latent representation
# ---------------------------------

rule run_peakvi:
    input:
        h5ad="results/anndata/{atlas}/{atlas}_peakvi_input.h5ad"
    output:
        model_dir=directory("results/peakvi/{atlas}/model"),
        latent_tsv="results/peakvi/{atlas}/{atlas}_peakvi_latent.tsv",
        latent_npy="results/peakvi/{atlas}/peakvi_latent.npy",
        cell_names="results/peakvi/{atlas}/cell_names.txt",
        history_tsv="results/peakvi/{atlas}/peakvi_training_history.tsv",
        convergence_png="figures/peakvi_convergence/{atlas}/peakvi_convergence_loss.png",
        summary="results/peakvi/{atlas}/peakvi_run_summary.json",
        h5ad="results/peakvi/{atlas}/{atlas}_peakvi.h5ad"
    log:
        "logs/peakvi/{atlas}.log"
    benchmark:
        "logs/benchmarking/peakvi/{atlas}.tsv"
    threads: 8
    resources:
        mem_mb=256000,
        runtime=2880,
        slurm_partition="gpu",
        slurm_account="cedar",
        slurm_extra='-G "a40:1"'
    params:
        output_dir=lambda wc: f"results/peakvi/{wc.atlas}",
        n_latent=PEAKVI_N_LATENT,
        latent_distribution=PEAKVI_LATENT_DISTRIBUTION,
        max_epochs=PEAKVI_MAX_EPOCHS,
        epoch_multiplier=PEAKVI_EPOCH_MULTIPLIER,
        batch_size=PEAKVI_BATCH_SIZE,
        random_seed=PEAKVI_RANDOM_SEED,
        early_stopping_patience=PEAKVI_EARLY_STOPPING_PATIENCE,
        dataloader_workers=PEAKVI_DATALOADER_WORKERS,
        epochs_cap=PEAKVI_EPOCHS_CAP,
        decay_at_n_obs=PEAKVI_DECAY_AT_N_OBS
    shell:
        r"""
        set +u
        eval "$(conda shell.bash hook)"
        conda activate scvi
        set -u
        export TMPDIR=${{TMPDIR:-/tmp}}
        export MPLCONFIGDIR=${{MPLCONFIGDIR:-/tmp/mpl-$USER-$SLURM_JOB_ID}}
        python scripts/02_3_run_peakvi.py \
            --input_h5ad {input.h5ad} \
            --atlas {wildcards.atlas} \
            --output_dir {params.output_dir} \
            --latent_tsv {output.latent_tsv} \
            --output_h5ad {output.h5ad} \
            --history_tsv {output.history_tsv} \
            --convergence_png {output.convergence_png} \
            --n_latent {params.n_latent} \
            --latent_distribution {params.latent_distribution} \
            --max_epochs {params.max_epochs} \
            --epoch_multiplier {params.epoch_multiplier} \
            --epochs_cap {params.epochs_cap} \
            --decay_at_n_obs {params.decay_at_n_obs} \
            --batch_size {params.batch_size} \
            --early_stopping false \
            --early_stopping_patience {params.early_stopping_patience} \
            --dataloader_workers {params.dataloader_workers} \
            --accelerator gpu \
            --random_seed {params.random_seed} \
            > {log} 2>&1
        """


