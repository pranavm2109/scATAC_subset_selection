        slurm_account="cedar"
    params:
        fraction=lambda wc: LEGACY_DIAGNOSTIC_FRACTIONS[wc.frac]
    wildcard_constraints:
        frac="04pct|06pct|08pct|10pct"
    shell:
        r"""
        set +u
        eval "$(conda shell.bash hook)"
        conda activate myenv
        set -u

        export TMPDIR=${{TMPDIR:-/tmp}}
        export OMP_NUM_THREADS={threads}
        export MKL_NUM_THREADS={threads}
        export OPENBLAS_NUM_THREADS={threads}

        python {input.script:q} \
            --atlas {wildcards.atlas:q} \
            --method l1 \
            --feature_matrix {input.features:q} \
            --cell_names {input.cell_names:q} \
            --landmark_metadata {input.metadata:q} \
            --baseline_selected_cells {input.baseline:q} \
            --output_selected_cells {output.selected:q} \
            --output_summary_tsv {output.summary:q} \
            --fraction {params.fraction} \
            --chunk_size 25000 \
            --random_seed {PEAKVI_LANDMARK_RANDOM_SEED} \
            > {log:q} 2>&1
        """


rule summarize_l1_normalization_generalization:
    input:
        script="diagnostics/summarize_l1_normalization_generalization.py",
        cell_names="results/peakvi/{atlas}/cell_names.txt",
        cell_metadata=(
            "results/cell_metadata/{atlas}/{atlas}_cell_metadata.tsv"
        ),
        umap="results/umap_peakvi/{atlas}/{atlas}_peakvi_umap.tsv",
        baseline=lambda wc: expand(
            (
                "results/subset_selection/peakvi/{atlas}/"
                "selected_cells_peakvi_{frac}.txt"
            ),
            atlas=wc.atlas,
            frac=LEGACY_DIAGNOSTIC_FRACTIONS.keys(),
        ),
        l1=lambda wc: [
            (
                "diagnostics/rbf_normalization_ablation/"
                f"{wc.atlas}/l1/selected_cells_02pct.txt"
            ),
            *expand(
                (
                    "diagnostics/rbf_normalization_ablation/{atlas}/l1/"
                    "selected_cells_{frac}.txt"
                ),
                atlas=wc.atlas,
                frac=["04pct", "06pct", "08pct", "10pct"],
            ),
        ],
        l1_summaries=lambda wc: [
            (
                "diagnostics/rbf_normalization_ablation/"
                f"{wc.atlas}/l1/run_summary.tsv"
            ),
            *expand(
                (
                    "diagnostics/rbf_normalization_ablation/{atlas}/l1/"
                    "run_summary_{frac}.tsv"
                ),
                atlas=wc.atlas,
                frac=["04pct", "06pct", "08pct", "10pct"],
            ),
        ]
    output:
        methods=(
            "diagnostics/rbf_normalization_generalization/{atlas}/"
            "fraction_method_summary.tsv"
        ),
        cell_types=(
            "diagnostics/rbf_normalization_generalization/{atlas}/"
            "cell_type_fraction_details.tsv"
        ),
        changes=(
            "diagnostics/rbf_normalization_generalization/{atlas}/"
            "retention_changes.tsv"
        ),
        retention=(
            "diagnostics/rbf_normalization_generalization/{atlas}/figures/"
            "retention_across_fractions.png"
        ),
        composition=(
            "diagnostics/rbf_normalization_generalization/{atlas}/figures/"
            "composition_across_fractions.png"
        ),
        coverage=(
            "diagnostics/rbf_normalization_generalization/{atlas}/figures/"
            "umap_coverage_across_fractions.png"
        )
    log:
        "logs/diagnostics/rbf_normalization_generalization/{atlas}_summary.log"
    benchmark:
        "logs/benchmarking/diagnostics/rbf_normalization_generalization/"
        "{atlas}_summary.tsv"
    threads: 2
    resources:
        mem_mb=16000,
        runtime=480,
        slurm_account="cedar"
    shell:
        r"""
        set +u
        eval "$(conda shell.bash hook)"
        conda activate scvi
        set -u

        export TMPDIR=${{TMPDIR:-/tmp}}
        export MPLCONFIGDIR=${{MPLCONFIGDIR:-/tmp/mpl-$USER-$SLURM_JOB_ID}}
        export OMP_NUM_THREADS={threads}
        export MKL_NUM_THREADS={threads}
        export OPENBLAS_NUM_THREADS={threads}

        python {input.script:q} \
            --atlas {wildcards.atlas:q} \
            --cell_names {input.cell_names:q} \
            --cell_metadata {input.cell_metadata:q} \
            --umap_tsv {input.umap:q} \
            --baseline_selected {input.baseline:q} \
            --l1_selected {input.l1:q} \
            --output_method_summary {output.methods:q} \
            --output_cell_type_details {output.cell_types:q} \
            --output_retention_changes {output.changes:q} \
            --output_retention_png {output.retention:q} \
            --output_composition_png {output.composition:q} \
            --output_umap_coverage_png {output.coverage:q} \
            --cell_type_column cell_type \
            --rare_threshold 0.01 \
            --chunk_size 50000 \
            --dpi 320 \
            > {log:q} 2>&1
        """
