# ---------------------------------
# Step 3.1: build annotation-blind PeakVI RBF landmark features
# One shared feature matrix is built per atlas and reused for all fractions.
# ---------------------------------

rule build_peakvi_landmark_features:
    input:
        script="scripts/03_subset_selection_on_peakvi.py",
        latent_npy="results/peakvi/{atlas}/peakvi_latent.npy",
        cell_names="results/peakvi/{atlas}/cell_names.txt",
        peakvi_summary="results/peakvi/{atlas}/peakvi_run_summary.json"
    output:
        features=(
            "results/peakvi_landmark_features/{atlas}/"
            "peakvi_rbf_landmark_features.npy"
        ),
        centroids=(
            "results/peakvi_landmark_features/{atlas}/"
            "peakvi_landmark_centroids.npy"
        ),
        metadata=(
            "results/peakvi_landmark_features/{atlas}/"
            "peakvi_landmark_metadata.json"
        ),
        sigma=(
            "results/peakvi_landmark_features/{atlas}/"
            "peakvi_landmark_sigma.tsv"
        )
    log:
        "logs/subset_selection/peakvi_landmarks/{atlas}.log"
    benchmark:
        "logs/benchmarking/subset_selection/peakvi_landmarks/{atlas}.tsv"
    threads: 4
    resources:
        mem_mb=16000,
        runtime=720,
        slurm_account="cedar"
    params:
        n_landmarks=PEAKVI_LANDMARK_N,
        latent_distribution=PEAKVI_LATENT_DISTRIBUTION,
        random_seed=PEAKVI_LANDMARK_RANDOM_SEED,
        kmeans_batch_size=PEAKVI_LANDMARK_KMEANS_BATCH_SIZE,
        kmeans_max_iter=PEAKVI_LANDMARK_KMEANS_MAX_ITER,
        kmeans_n_init=PEAKVI_LANDMARK_KMEANS_N_INIT,
        kmeans_max_no_improvement=PEAKVI_LANDMARK_KMEANS_MAX_NO_IMPROVEMENT,
        kmeans_reassignment_ratio=PEAKVI_LANDMARK_KMEANS_REASSIGNMENT_RATIO,
        distance_chunk_size=PEAKVI_LANDMARK_DISTANCE_CHUNK_SIZE
    shell:
        r"""
        set +u
        eval "$(conda shell.bash hook)"
        conda activate myenv
        set -u

        export TMPDIR=${{TMPDIR:-/tmp}}
        export OMP_NUM_THREADS={threads}
        export MKL_NUM_THREADS={threads}
        export OPENBLAS_NUM_THREADS={threads}

        python {input.script} \
            --mode build_features \
            --atlas {wildcards.atlas} \
            --latent_npy {input.latent_npy} \
            --cell_names {input.cell_names} \
            --peakvi_run_summary {input.peakvi_summary} \
            --feature_matrix {output.features} \
            --centroids {output.centroids} \
            --landmark_metadata {output.metadata} \
            --sigma_tsv {output.sigma} \
            --n_landmarks {params.n_landmarks} \
            --latent_distribution {params.latent_distribution} \
            --random_seed {params.random_seed} \
            --kmeans_batch_size {params.kmeans_batch_size} \
            --kmeans_max_iter {params.kmeans_max_iter} \
            --kmeans_n_init {params.kmeans_n_init} \
