from pathlib import Path

shell.executable("/bin/bash")

# ---------------------------------
# Global settings
# ---------------------------------

ATLASES = [
    "kidney_atac",
    "heca_atac",
    "fetal_atac",
]

FRACTIONS = {
    "02pct": "0.02",
    "04pct": "0.04",
    "06pct": "0.06",
    "08pct": "0.08",
    "10pct": "0.10",
}

# Temporary diagnostics below document the completed 2-10% experiments.
LEGACY_DIAGNOSTIC_FRACTIONS = {
    "02pct": "0.02",
    "04pct": "0.04",
    "06pct": "0.06",
    "08pct": "0.08",
    "10pct": "0.10",
}

DENSITY_GENERALIZATION_ATLASES = ["fetal_atac", "kidney_atac"]


def density_generalization_selected_path(atlas, frac):
    if atlas == "fetal_atac" and frac == "02pct":
        return (
            "diagnostics/density_weighted_ablation/fetal_atac/02pct/"
            "selected_cells_density_max_2p0_02pct.txt"
        )
    return (
        f"diagnostics/density_weighted_generalization/selections/{atlas}/{frac}/"
        f"selected_cells_density_max_2p0_{frac}.txt"
    )


DENSITY_GENERALIZATION_SELECTED = [
    density_generalization_selected_path(atlas, frac)
    for atlas in DENSITY_GENERALIZATION_ATLASES
    for frac in LEGACY_DIAGNOSTIC_FRACTIONS.keys()
]

KIDNEY_DENSITY_CAPS = {
    "1p5": "1.5",
    "1p6": "1.6",
    "1p7": "1.7",
    "1p8": "1.8",
    "1p9": "1.9",
}
KIDNEY_DENSITY_ALL_CAPS = [*KIDNEY_DENSITY_CAPS.keys(), "2p0"]


def kidney_density_cap_selected_path(cap, frac):
    if cap == "2p0":
        return (
            "diagnostics/density_weighted_generalization/selections/"
            f"kidney_atac/{frac}/selected_cells_density_max_2p0_{frac}.txt"
        )
    return (
        "diagnostics/kidney_density_cap_ablation/selections/"
        f"{cap}/{frac}/selected_cells_density_max_{cap}_{frac}.txt"
    )


KIDNEY_DENSITY_CAP_SELECTED = [
    kidney_density_cap_selected_path(cap, frac)
    for cap in KIDNEY_DENSITY_ALL_CAPS
    for frac in LEGACY_DIAGNOSTIC_FRACTIONS.keys()
]

HYBRID_RBF_DENSITY_ATLASES = ["kidney_atac", "fetal_atac"]
HYBRID_RBF_DENSITY_SELECTED = [
    (
        "diagnostics/hybrid_rbf_density_ablation/selections/"
        f"{atlas}/{frac}/selected_cells_hybrid_{frac}.txt"
    )
    for atlas in HYBRID_RBF_DENSITY_ATLASES
    for frac in LEGACY_DIAGNOSTIC_FRACTIONS.keys()
]

SIGNAC_DA_DATASET_SIZES = list(FRACTIONS.keys()) + ["100pct"]
SIGNAC_DA_RUN_ORDER = ["100pct"] + list(FRACTIONS.keys())

COVERAGE_LOG_TRANSFORMS = {
    "log": "true",
    "linear": "false",
}

PEAKVI_N_LATENT = 60
PEAKVI_LATENT_DISTRIBUTION = "normal"
PEAKVI_MAX_EPOCHS = "auto"
PEAKVI_EPOCH_MULTIPLIER = 2
PEAKVI_BATCH_SIZE = 2048
PEAKVI_RANDOM_SEED = 123
PEAKVI_EARLY_STOPPING_PATIENCE = 10
PEAKVI_DATALOADER_WORKERS = 0
PEAKVI_EPOCHS_CAP = 400
PEAKVI_DECAY_AT_N_OBS = 20000

PEAKVI_LANDMARK_N = 1024
PEAKVI_LANDMARK_RANDOM_SEED = 123
PEAKVI_LANDMARK_KMEANS_BATCH_SIZE = 8192
PEAKVI_LANDMARK_KMEANS_MAX_ITER = 100
PEAKVI_LANDMARK_KMEANS_N_INIT = 3
PEAKVI_LANDMARK_KMEANS_MAX_NO_IMPROVEMENT = 20
PEAKVI_LANDMARK_KMEANS_REASSIGNMENT_RATIO = 0.01
PEAKVI_LANDMARK_DISTANCE_CHUNK_SIZE = 50000
PEAKVI_DENSITY_KNN_K = 30
PEAKVI_DENSITY_MAX_WEIGHT = 2.0
COMMON_DENSITY_CAP_05PCT_WEIGHTS = "1.25,1.4,1.5,1.6,1.7,1.8,1.9,2.0"
MINIMUM_LANDMARK_DIAGNOSTIC_COUNTS = "256,512,768,1024,1536,2048,3072,4096"
MINIMUM_LANDMARK_DIAGNOSTIC_SEEDS = "123,456,789"

ATLAS_INFO = {
    "kidney_atac": {
        "preprocess_script": "scripts/01_1_preprocessing_kidney_atac.R",
    },
    "heca_atac": {
        "preprocess_script": "scripts/01_2_preprocessing_heca_atac.R",
    },
    "fetal_atac": {
        "preprocess_script": "scripts/01_3_preprocessing_fetal_atac.R",
    },
}


def preprocess_script(wc):
    return ATLAS_INFO[wc.atlas]["preprocess_script"]


