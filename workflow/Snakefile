# Step 4: compute cell-type proportions in atlas vs PeakVI subsets
# ---------------------------------

rule compute_cell_type_proportions:
    input:
        rds="data/processed/{atlas}/{atlas}_barebones_seurat.rds",
        subsets=lambda wc: expand(
            (
                "results/subset_selection/peakvi/{atlas}/"
                "selected_cells_peakvi_{frac}.txt"
            ),
            atlas=wc.atlas,
            frac=FRACTIONS.keys(),
        )
    output:
        tsv="results/cell_type_proportions/peakvi/{atlas}/cell_type_proportions_peakvi.tsv",
        tidy_tsv="results/cell_type_proportions/peakvi/{atlas}/cell_type_fractions_tidy.tsv"
    log:
        "logs/cell_type_proportions/peakvi/{atlas}.log"
    benchmark:
        "logs/benchmarking/cell_type_proportions/peakvi/{atlas}.tsv"
    threads: 1
    resources:
        mem_mb=16000,
        runtime=120
    params:
        subset_dir=lambda wc: f"results/subset_selection/peakvi/{wc.atlas}",
        fractions=','.join(FRACTIONS.keys()),
        prefix="selected_cells_peakvi"
    shell:
        r"""
        set +u
        eval "$(conda shell.bash hook)"
        conda activate r_env2
        set -u
        export TMPDIR=${{TMPDIR:-/tmp}}
        export MPLCONFIGDIR=${{MPLCONFIGDIR:-/tmp/mpl-$USER-$SLURM_JOB_ID}}
        Rscript scripts/06_1_compute_cell_type_proportions.R \
            {input.rds} \
            {params.subset_dir} \
            {output.tsv} \
            {output.tidy_tsv} \
            {params.fractions} \
            {params.prefix} \
            > {log} 2>&1
        """


rule plot_cell_type_alluvial:
    input:
        proportions_tsv="results/cell_type_proportions/peakvi/{atlas}/cell_type_proportions_peakvi.tsv"
