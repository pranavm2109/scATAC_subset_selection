rule subset_selection_peakvi:
    input:
        script="scripts/03_subset_selection_on_peakvi.py",
        cell_names="results/peakvi/{atlas}/cell_names.txt",
        features=(
            "results/peakvi_landmark_features/{atlas}/"
            "peakvi_rbf_landmark_features.npy"
        ),
        centroids=(
            "results/peakvi_landmark_features/{atlas}/"
            "peakvi_landmark_centroids.npy"
        ),
        metadata=(
            "results/peakvi_landmark_features/{atlas}/"
            "peakvi_landmark_metadata.json"
        ),
        sigma=(
            "results/peakvi_landmark_features/{atlas}/"
            "peakvi_landmark_sigma.tsv"
        )
    output:
        selected_cells=(
            "results/subset_selection/peakvi/{atlas}/"
            "selected_cells_peakvi_{frac}.txt"
        ),
        summary=(
            "results/subset_selection/peakvi/{atlas}/"
            "subset_selection_summary_peakvi_{frac}.tsv"
        )
    log:
        "logs/subset_selection/peakvi/{atlas}_{frac}.log"
    benchmark:
        "logs/benchmarking/subset_selection/peakvi/{atlas}_{frac}.tsv"
    threads: 2
    resources:
        mem_mb=32000,
        runtime=2880,
        slurm_account="cedar"
    params:
        outdir=lambda wc: (
            f"results/subset_selection/peakvi/{wc.atlas}"
        ),
        fraction=lambda wc: FRACTIONS[wc.frac],
        random_seed=PEAKVI_LANDMARK_RANDOM_SEED
    wildcard_constraints:
        frac="02pct|04pct|06pct|08pct|10pct"
    shell:
        r"""
        set +u
        eval "$(conda shell.bash hook)"
        conda activate myenv
        set -u

        export TMPDIR=${{TMPDIR:-/tmp}}
        export MPLCONFIGDIR=${{MPLCONFIGDIR:-/tmp/mpl-$USER-$SLURM_JOB_ID}}

        python {input.script} \
            --mode select \
            --atlas {wildcards.atlas} \
            --cell_names {input.cell_names} \
            --feature_matrix {input.features} \
            --centroids {input.centroids} \
            --landmark_metadata {input.metadata} \
            --sigma_tsv {input.sigma} \
            --outdir {params.outdir} \
            --fraction {params.fraction} \
            --random_seed {params.random_seed} \
            > {log} 2>&1
        """


