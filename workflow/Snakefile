# ---------------------------------
# Step 5: UMAP directly from the PeakVI latent representation
# ---------------------------------

rule run_peakvi_umap:
    input:
        latent_tsv="results/peakvi/{atlas}/{atlas}_peakvi_latent.tsv"
    output:
        umap_tsv="results/umap_peakvi/{atlas}/{atlas}_peakvi_umap.tsv",
        done="results/umap_peakvi/{atlas}/peakvi_umap.done"
    log:
        "logs/umap_peakvi/{atlas}.log"
    benchmark:
        "logs/benchmarking/umap_peakvi/{atlas}.tsv"
    threads: 8
    resources:
        mem_mb=128000,
        runtime=1440
    params:
        n_neighbors=15,
        min_dist=0.2,
        random_seed=PEAKVI_RANDOM_SEED
    shell:
        r"""
        set +u
        eval "$(conda shell.bash hook)"
        conda activate scvi
        set -u
        export TMPDIR=${{TMPDIR:-/tmp}}
        export MPLCONFIGDIR=${{MPLCONFIGDIR:-/tmp/mpl-$USER-$SLURM_JOB_ID}}
        export OMP_NUM_THREADS={threads}
        export MKL_NUM_THREADS={threads}
        export OPENBLAS_NUM_THREADS={threads}
        python scripts/04_run_peakvi_umap.py \
            --latent_tsv {input.latent_tsv} \
            --output_umap_tsv {output.umap_tsv} \
            --output_done {output.done} \
            --n_neighbors {params.n_neighbors} \
            --min_dist {params.min_dist} \
            --random_seed {params.random_seed} \
            > {log} 2>&1
        """


