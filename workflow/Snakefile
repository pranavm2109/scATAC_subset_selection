# ---------------------------------
# Step 9.1: Signac DA for every cell type in the full atlas and each subset
# ---------------------------------

def signac_da_selected_cells(wc):
    if wc.dataset_size == "100pct":
        return []
    return (
        f"results/subset_selection/peakvi/{wc.atlas}/"
        f"selected_cells_peakvi_{wc.dataset_size}.txt"
    )


def signac_da_selected_cells_argument(wc):
    if wc.dataset_size == "100pct":
        return "FULL"
    return (
        f"results/subset_selection/peakvi/{wc.atlas}/"
        f"selected_cells_peakvi_{wc.dataset_size}.txt"
    )


def signac_da_full_reference(wc):
    if wc.dataset_size == "100pct":
        return []
    return (
        f"results/signac_da/{wc.atlas}/100pct/"
        "signac_da_peaks.tsv"
    )


def signac_da_full_reference_argument(wc):
    if wc.dataset_size == "100pct":
        return "SELF"
    return (
        f"results/signac_da/{wc.atlas}/100pct/"
        "signac_da_peaks.tsv"
    )


def previous_signac_da_status(wc):
    """Serialize DA jobs that read the same atlas BPCells directory."""
    position = SIGNAC_DA_RUN_ORDER.index(wc.dataset_size)
    if position == 0:
        return []
    previous_size = SIGNAC_DA_RUN_ORDER[position - 1]
    return (
        f"results/signac_da/{wc.atlas}/{previous_size}/"
        "signac_da_status.tsv"
    )


rule run_signac_da_all_cell_types:
    input:
        script="scripts/09_1_run_signac_da_all_cell_types.R",
        rds="data/processed/{atlas}/{atlas}_barebones_seurat.rds",
        selected_cells=signac_da_selected_cells,
        full_reference=signac_da_full_reference,
        previous_status=previous_signac_da_status
    output:
        peaks=(
            "results/signac_da/{atlas}/{dataset_size}/"
            "signac_da_peaks.tsv"
        ),
        status=(
            "results/signac_da/{atlas}/{dataset_size}/"
            "signac_da_status.tsv"
        ),
        reference_effects=(
            "results/signac_da/{atlas}/{dataset_size}/"
            "signac_da_reference_effects.tsv"
        )
    log:
        "logs/signac_da/{atlas}/{dataset_size}.log"
    benchmark:
        "logs/benchmarking/signac_da/{atlas}/{dataset_size}.tsv"
    threads: 4
    resources:
        mem_mb=lambda wc: 256000 if wc.dataset_size == "100pct" else 128000,
        runtime=2880,
        slurm_account="cedar"
    params:
        selected_cells=signac_da_selected_cells_argument,
        full_reference=signac_da_full_reference_argument,
        min_target_cells=10,
        min_rest_cells=20,
        fdr_threshold=0.05,
        abs_log2fc_threshold=0.25,
        min_pct=0.01
    wildcard_constraints:
        dataset_size="02pct|04pct|06pct|08pct|10pct|100pct"
    shell:
        r"""
        set +u
        eval "$(conda shell.bash hook)"
        conda activate r_env2
        set -u

        export TMPDIR=${{TMPDIR:-/tmp}}
        export MPLCONFIGDIR=${{MPLCONFIGDIR:-/tmp/mpl-$USER-$SLURM_JOB_ID}}
        export SIGNAC_DA_TMPDIR="/home/groups/CEDAR/mishrap/scATAC_subset_selection/tmp/signac_da"
        mkdir -p "$SIGNAC_DA_TMPDIR"
        export OMP_NUM_THREADS={threads}
        export MKL_NUM_THREADS={threads}
        export OPENBLAS_NUM_THREADS={threads}

        Rscript {input.script:q} \
            {input.rds:q} \
            {params.selected_cells:q} \
            {wildcards.atlas:q} \
            {wildcards.dataset_size:q} \
            {output.peaks:q} \
            {output.status:q} \
            {output.reference_effects:q} \
            {params.full_reference:q} \
            {params.min_target_cells} \
            {params.min_rest_cells} \
            {params.fdr_threshold} \
            {params.abs_log2fc_threshold} \
            {params.min_pct} \
            > {log:q} 2>&1
        """


